# Entorno de ejecucion (development | test | production)
NODE_ENV=development

# Puerto HTTP donde escucha el servidor Express
PORT=4000

# Origen permitido para CORS (puede ser un origen unico o lista separada por comas)
CORS_ORIGIN=http://localhost:5173

# Cadena de conexion a PostgreSQL (en produccion usar Supabase Pooler)
DATABASE_URL=postgresql://postgres:password@localhost:5432/securevault

# Habilitar SSL hacia PostgreSQL (true en produccion / Supabase)
DB_SSL=false

# Secreto para firmar JWT de acceso (minimo 64 caracteres hexadecimales / 32 bytes)
JWT_ACCESS_SECRET=replace_with_64_hex_chars

# Secreto para proteccion CSRF (minimo 64 caracteres hexadecimales / 32 bytes)
CSRF_SECRET=replace_with_64_hex_chars

# Version activa de la clave de cifrado de datos (DEK) para rotacion de claves
ACTIVE_KEY_VERSION=1

# Clave de cifrado AES-256-GCM version 1 codificada en Base64 (exactamente 32 bytes decodificados)
DATA_ENCRYPTION_KEY_V1=replace_with_32_bytes_base64

# Webhook opcional de Discord para alertas de seguridad criticas (dejar vacio si no se usa)
DISCORD_WEBHOOK_URL=

# Variables opcionales usadas exclusivamente por el script CLI npm run seed:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
ADMIN_COMPANY=
ADMIN_PHONE=
